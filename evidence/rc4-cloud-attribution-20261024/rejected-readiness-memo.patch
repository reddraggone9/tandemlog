diff --git a/lib/storage/task_readiness_availability_memo.dart b/lib/storage/task_readiness_availability_memo.dart
new file mode 100644
index 0000000..0b9d5b5
--- /dev/null
+++ b/lib/storage/task_readiness_availability_memo.dart
@@ -0,0 +1,54 @@
+import 'dart:convert';
+
+/// Exact decoding reuse only; callers must supply a fresh live SQL result.
+/// Values describe text availability, never readiness or admission authority.
+class TaskReadinessAvailabilityMemo {
+  static const maximumRows = 4096;
+  static const maximumRetainedBytes = 4 * 1024 * 1024;
+  static const _nonStringReason = Object();
+  Map<String, (String, Object?)> _memo = {};
+  int _retainedBytes = 0;
+  int decodedRows = 0;
+  int get retainedBytes => _retainedBytes;
+  int get retainedRows => _memo.length;
+
+  Map<String, Object?> read(Iterable<(String, String)> rows) {
+    final result = <String, Object?>{};
+    final next = <String, (String, Object?)>{};
+    var bytes = 0;
+    var retain = true;
+    for (final (id, raw) in rows) {
+      final previous = _memo[id];
+      final Object? reason;
+      if (previous != null && previous.$1 == raw) {
+        reason = previous.$2;
+      } else {
+        decodedRows++;
+        final value = (jsonDecode(raw) as Map)['textUnavailable'];
+        reason = value == null || value is String ? value : _nonStringReason;
+      }
+      result[id] = reason;
+      if (retain) {
+        bytes +=
+            256 +
+            id.length * 2 +
+            raw.length * 2 +
+            (reason is String ? reason.length * 2 : 0);
+        if (next.length < maximumRows && bytes <= maximumRetainedBytes) {
+          next[id] = (raw, reason);
+        } else {
+          retain = false;
+          next.clear();
+        }
+      }
+    }
+    _memo = next;
+    _retainedBytes = retain ? bytes : 0;
+    return result;
+  }
+
+  void clear() {
+    _memo = {};
+    _retainedBytes = 0;
+  }
+}
diff --git a/test/task_readiness_availability_memo_test.dart b/test/task_readiness_availability_memo_test.dart
new file mode 100644
index 0000000..bebfdfa
--- /dev/null
+++ b/test/task_readiness_availability_memo_test.dart
@@ -0,0 +1,195 @@
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:sqlite3/sqlite3.dart';
+import 'package:tandemlog/storage/task_readiness_availability_memo.dart';
+
+typedef _Row = (String, String);
+
+Map<String, Map> _oldStates(List<_Row> rows) => {
+  for (final (id, raw) in rows) id: jsonDecode(raw) as Map,
+};
+
+void _compare(TaskReadinessAvailabilityMemo memo, List<_Row> rows) {
+  final expected = _oldStates(rows), actual = memo.read(rows);
+  expect(actual.keys.toList(), expected.keys.toList());
+  for (final id in [...expected.keys, 'missing']) {
+    for (final competing in [false, true]) {
+      for (final blocked in <String?>[
+        null,
+        'blocked',
+        '{"x":1}',
+        '[1]',
+        'unicode 🧭\n',
+      ]) {
+        final state = expected[id];
+        final oldAvailable =
+            state != null &&
+            (state['textUnavailable'] == null ||
+                competing && state['textUnavailable'] == blocked);
+        final available =
+            actual.containsKey(id) &&
+            (actual[id] == null || competing && actual[id] == blocked);
+        expect(available, oldAvailable, reason: '$id competing=$competing');
+      }
+    }
+  }
+}
+
+Object _failure(void Function() body) {
+  try {
+    body();
+  } catch (error) {
+    return error;
+  }
+  throw StateError('Expected decoding failure.');
+}
+
+void main() {
+  test('availability matches full JSON oracle for every reason type', () {
+    final memo = TaskReadinessAvailabilityMemo();
+    final rows = <_Row>[
+      ('absent', '{}'),
+      ('null', '{"textUnavailable":null}'),
+      for (final value in <Object>[
+        'blocked',
+        '{"x":1}',
+        '[1]',
+        '',
+        true,
+        false,
+        1,
+        1.5,
+        <Object>[],
+        <String, Object>{},
+        [1],
+        {'x': 1},
+        'unicode 🧭\n',
+      ])
+        (
+          'reason-${jsonEncode(value)}',
+          jsonEncode({
+            'textUnavailable': value,
+            'unrelated': {'title': 'Synthetic'},
+          }),
+        ),
+      ('duplicate', '{"textUnavailable":"old","textUnavailable":null}'),
+    ];
+    _compare(memo, rows);
+    final decoded = memo.decodedRows;
+    _compare(memo, rows.reversed.toList());
+    expect(memo.decodedRows, decoded);
+    final exposed = memo.read(rows);
+    exposed['absent'] = 'blocked';
+    exposed.remove('null');
+    _compare(memo, rows);
+  });
+
+  test('exact changed bytes and duplicate IDs retain current row meaning', () {
+    final memo = TaskReadinessAvailabilityMemo();
+    _compare(memo, [('same', '{"textUnavailable":"blocked"}')]);
+    final decoded = memo.decodedRows;
+    _compare(memo, [('same', '{"textUnavailable":null}')]);
+    expect(memo.decodedRows, decoded + 1);
+    _compare(memo, [
+      ('same', '{"textUnavailable":"first"}'),
+      ('same', '{"textUnavailable":"blocked"}'),
+    ]);
+    _compare(memo, [('same', r'{"textUnavailable":"unicode \ud83e\udded\n"}')]);
+    final beforeLiteral = memo.decodedRows;
+    _compare(memo, [
+      ('same', jsonEncode({'textUnavailable': 'unicode 🧭\n'})),
+    ]);
+    expect(memo.decodedRows, beforeLiteral + 1);
+    _compare(memo, []);
+    expect(memo.retainedRows, 0);
+  });
+
+  test('malformed JSON and nonobject roots keep original errors', () {
+    final memo = TaskReadinessAvailabilityMemo();
+    final valid = <_Row>[('changed', '{}')];
+    for (final raw in [
+      '{"textUnavailable":',
+      '[]',
+      'null',
+      '"text"',
+      '1',
+      'true',
+    ]) {
+      _compare(memo, valid);
+      final rows = <_Row>[('first', '{}'), ('changed', raw)];
+      for (var attempt = 0; attempt < 2; attempt++) {
+        final old = _failure(() => _oldStates(rows));
+        final actual = _failure(() => memo.read(rows));
+        expect(actual.runtimeType, old.runtimeType);
+        expect(actual.toString(), old.toString());
+      }
+      _compare(memo, valid);
+    }
+  });
+
+  test('live SQLite staged updates, deletion and rollback remain visible', () {
+    final memo = TaskReadinessAvailabilityMemo();
+    final db = sqlite3.openInMemory();
+    addTearDown(db.close);
+    db.execute('CREATE TABLE views(id TEXT PRIMARY KEY, raw TEXT)');
+    db.execute('INSERT INTO views VALUES (?,?)', ['present', '{}']);
+    List<_Row> live() => [
+      for (final row in db.select('SELECT id,raw FROM views'))
+        (row['id'] as String, row['raw'] as String),
+    ];
+    _compare(memo, live());
+    db.execute('BEGIN IMMEDIATE');
+    db.execute('UPDATE views SET raw=? WHERE id=?', [
+      '{"textUnavailable":"blocked"}',
+      'present',
+    ]);
+    db.execute('INSERT INTO views VALUES (?,?)', ['staged', '{}']);
+    _compare(memo, live());
+    db.execute('DELETE FROM views WHERE id=?', ['present']);
+    _compare(memo, live());
+    db.execute('ROLLBACK');
+    _compare(memo, live());
+    expect(memo.read(live()).containsKey('present'), isTrue);
+    expect(memo.read(live()).containsKey('staged'), isFalse);
+    db.execute('UPDATE views SET raw=?', ['{"textUnavailable":']);
+    expect(() => memo.read(live()), throwsFormatException);
+    db.execute('UPDATE views SET raw=?', ['{}']);
+    _compare(memo, live());
+  });
+
+  test('row bound bypasses retention while preserving complete results', () {
+    final memo = TaskReadinessAvailabilityMemo();
+    final rows = <_Row>[
+      for (var i = 0; i < TaskReadinessAvailabilityMemo.maximumRows; i++)
+        ('row-$i', '{}'),
+    ];
+    _compare(memo, rows);
+    expect(memo.retainedRows, TaskReadinessAvailabilityMemo.maximumRows);
+    _compare(memo, [...rows, ('overflow', '{"textUnavailable":"blocked"}')]);
+    expect(memo.retainedRows, 0);
+    expect(memo.retainedBytes, 0);
+    _compare(memo, [('only-current', '{}')]);
+    expect(memo.retainedRows, 1);
+  });
+
+  test('byte bound bypass and owner clear retain no older generation', () {
+    final memo = TaskReadinessAvailabilityMemo();
+    _compare(memo, [('old', '{}')]);
+    final large = jsonEncode({
+      'textUnavailable': null,
+      'description': 'x' * (3 * 1024 * 1024),
+    });
+    _compare(memo, [('large', large)]);
+    expect(memo.retainedRows, 0);
+    expect(memo.retainedBytes, 0);
+    _compare(memo, [('current', '{}')]);
+    expect(
+      memo.retainedBytes,
+      lessThanOrEqualTo(TaskReadinessAvailabilityMemo.maximumRetainedBytes),
+    );
+    memo.clear();
+    expect(memo.retainedRows, 0);
+    expect(memo.retainedBytes, 0);
+  });
+}
